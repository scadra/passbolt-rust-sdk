# Rust build #
######################
/target
**/target
*.rs.bk

# WASM / FFI build output #
######################
/crates/passbolt-wasm/pkg
/crates/passbolt-ffi/bindings
/crates/passbolt-ffi/dist
/bindings
*.wasm
*.so
*.dylib
*.dll

# Secrets & exports (never commit) #
######################
.env
.env.e2e
*.kdbx
*.asc
# The SDK test keys and messages are public by design.
!crates/passbolt-sdk/tests/fixtures/**/*.asc
*.gpg
*.pem
*.key
# The KeePass test files are public by design.
!crates/passbolt-cli/tests/fixtures/kdbx/*
/config.toml

# Coverage & profiling #
######################
/coverage
*.profraw
lcov.info
tarpaulin-report.html

# OS & editors #
######################
.DS_Store
Thumbs.db
.idea
.vscode
*.swp
*.swo
*~

# Test-only PGP fixtures (generated, no real secret)
!crates/*/tests/fixtures/keys/*.asc

# Interop checks (npm ci in tests/interop) #
######################
node_modules/
/packaging/android/build
/packaging/android/.gradle
/website/node_modules
/website/build
/website/.docusaurus

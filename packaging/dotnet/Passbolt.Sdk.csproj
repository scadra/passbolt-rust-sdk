<Project Sdk="Microsoft.NET.Sdk">
  <!-- Passbolt SDK for .NET: the UniFFI C# bindings (generated/) and the native library of
       each platform (runtimes/<rid>/native/, resolved by the .NET host). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Passbolt.Sdk</RootNamespace>
    <AssemblyName>Passbolt.Sdk</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <!-- The XML documentation of the generated code, for IntelliSense. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Generated code: its warnings are not ours to fix. -->
    <NoWarn>$(NoWarn);CS1591;CS1572;CS1573;CS1587;CS8632;CS0105</NoWarn>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <PackageId>SwitchCase.Passbolt.Sdk</PackageId>
    <Version>0.0.0</Version>
    <Authors>Passbolt SA</Authors>
    <Description>Passbolt SDK — .NET bindings of the Rust SDK: GPGAuth login, resources, folders, users, groups and sharing, with the encryption done in Rust.</Description>
    <PackageTags>passbolt;password-manager;openpgp;sdk</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/scadra/passbolt-rust-sdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/scadra/passbolt-rust-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="runtimes/**/*" Pack="true" PackagePath="runtimes/" />
  </ItemGroup>
</Project>
